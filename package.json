{
  "name": "@edutecka-mz/edpay-sdk",
  "version": "1.5.1",
  "description": "Official EDPay SDK for Node.js and TypeScript with multi-gateway payments, hosted checkout, and webhook verification.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./frontend": {
      "types": "./dist/frontend.d.ts",
      "require": "./dist/frontend.js",
      "default": "./dist/frontend.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/edutecka/edpay-javascript-sdk.git"
  },
  "homepage": "https://docs-pay.edutecka.com/sdks/",
  "bugs": {
    "url": "https://github.com/edutecka/edpay-javascript-sdk/issues"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || ^26.13.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "edpay",
    "payments",
    "mpesa",
    "emola",
    "mozambique",
    "gateway",
    "fintech"
  ],
  "author": "EDPay Engineering <dev@edutecka.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
